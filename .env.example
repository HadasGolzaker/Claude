# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values to git.

# Your Claude API key (kept secret, server-side only)
ANTHROPIC_API_KEY=sk-ant-...

# From your Supabase project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Optional: email the person a profile is shared with (resend.com)
RESEND_API_KEY=re_...
# Optional overrides
# MAIL_FROM=Voiceprint <noreply@voiceprint-app.com>
# SITE_URL=https://www.voiceprint-app.com
